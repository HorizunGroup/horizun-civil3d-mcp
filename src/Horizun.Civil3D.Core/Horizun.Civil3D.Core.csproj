<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-agnostic rules shared by the MCP server and the Civil 3D plug-in.
       NO Autodesk references here: everything in this assembly is tested
       without Civil 3D. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Horizun.Civil3D.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Horizun.Civil3D.Core.Tests" />
  </ItemGroup>
</Project>
