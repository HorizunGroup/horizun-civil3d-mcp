<Project>
  <PropertyGroup>
    <Version>0.9.2</Version>
    <Company>Horizun Group</Company>
    <Product>Horizun Civil 3D MCP</Product>
    <Copyright>Copyright 2026 Horizun Group</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Public binaries must not disclose the builder's checkout/profile paths. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <PathMap Condition="'$(USERPROFILE)' != ''">$(PathMap),$(USERPROFILE)=/_/user</PathMap>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
